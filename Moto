<style>
/* Layout: canvas a pantalla completa; HUD arriba, mandos táctiles abajo, menús como capas centradas */
:root {
  --sky-top: #23244d;
  --sky-mid: #6b3f7a;
  --sky-low: #f08a5d;
  --ink: #f7ecdc;
  --ink-dim: #c9b9c9;
  --ground: #1d1830;
  --ground-edge: #e0a84a;
  --accent: #ffd23f;
  --danger: #e63946;
  --panel: rgba(22, 17, 40, 0.88);
  --line: rgba(247, 236, 220, 0.18);
  --font-display: "Russo One", "Arial Black", Impact, sans-serif;
  --font-body: "Barlow", system-ui, -apple-system, "Segoe UI", sans-serif;
  color-scheme: dark;
}
html, body { height: 100%; }
body {
  margin: 0;
  background: var(--ground);
  color: var(--ink);
  font-family: var(--font-body);
  font-size: 16px;
  overflow: hidden;
  -webkit-user-select: none;
  user-select: none;
  touch-action: none;
}
#app { position: relative; width: 100%; height: 100%; overflow: hidden; }
#c { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }

button { font: inherit; color: inherit; cursor: pointer; }
button:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }

/* HUD */
#hud {
  position: absolute; left: 0; right: 0; top: 0;
  padding: 10px max(16px, env(safe-area-inset-left, 0px)) 0 max(16px, env(safe-area-inset-right, 0px));
  pointer-events: none;
  display: flex; flex-direction: column; gap: 8px;
}
#hud[hidden] { display: none; }
.hud-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
.hud-left, .hud-right { flex: 1 1 0; min-width: 0; display: flex; gap: 8px; }
.hud-right { justify-content: flex-end; flex-wrap: wrap; }
.hud-left { flex-direction: column; gap: 2px; }
#lvlname { font-family: var(--font-display); font-size: 15px; letter-spacing: 0.04em; text-transform: uppercase; text-shadow: 0 2px 0 rgba(0,0,0,.35); }
#stats { font-size: 14px; font-weight: 600; color: var(--ink); text-shadow: 0 1px 0 rgba(0,0,0,.4); font-variant-numeric: tabular-nums; }
#timer {
  font-family: var(--font-display); font-size: 30px; line-height: 1;
  font-variant-numeric: tabular-nums; text-shadow: 0 3px 0 rgba(0,0,0,.35);
  padding-top: 2px;
}
.chip {
  pointer-events: auto;
  background: var(--panel); border: 1px solid var(--line); border-radius: 6px;
  padding: 6px 10px; font-size: 13px; font-weight: 600; letter-spacing: 0.03em;
}
.chip:hover { border-color: var(--accent); }
#prog { position: relative; height: 8px; border-radius: 4px; background: rgba(0,0,0,.35); overflow: hidden; }
#progFill { position: absolute; left: 0; top: 0; bottom: 0; width: 0%; background: var(--accent); }
.tick { position: absolute; top: 0; bottom: 0; width: 2px; background: rgba(247,236,220,.7); }

/* Aviso breve */
#toast {
  position: absolute; left: 50%; top: 86px; transform: translate(-50%, -8px);
  background: var(--panel); border: 1px solid var(--accent); color: var(--ink);
  padding: 8px 16px; border-radius: 6px; font-weight: 600; letter-spacing: .04em;
  opacity: 0; pointer-events: none; transition: opacity .2s, transform .2s;
}
#toast.show { opacity: 1; transform: translate(-50%, 0); }

/* Mandos táctiles */
#touch {
  position: absolute; left: 0; right: 0; bottom: 0;
  display: none; justify-content: space-between; align-items: flex-end; gap: 12px;
  padding: 0 max(16px, env(safe-area-inset-right, 0px)) 14px max(16px, env(safe-area-inset-left, 0px));
  pointer-events: none;
}
#touch[hidden] { display: none !important; }
.show-touch #touch:not([hidden]) { display: flex; }
@media (pointer: coarse) { #touch:not([hidden]) { display: flex; } }
.pad { display: flex; gap: 10px; }
.pbtn {
  pointer-events: auto; touch-action: none;
  width: 84px; height: 84px; border-radius: 50%;
  background: rgba(22, 17, 40, 0.62); border: 2px solid var(--line);
  font-family: var(--font-display); font-size: 12px; letter-spacing: .06em; text-transform: uppercase;
  display: grid; place-items: center; text-align: center; line-height: 1.1;
}
.pbtn.on { background: var(--accent); color: #241b3a; border-color: var(--accent); }
.pbtn.gas { width: 100px; height: 100px; }

/* Capas de menú */
.overlay {
  position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
  padding: 16px max(16px, env(safe-area-inset-right, 0px)) 16px max(16px, env(safe-area-inset-left, 0px));
  background: rgba(16, 11, 30, 0.55);
  overflow-y: auto; touch-action: pan-y;
}
.overlay[hidden] { display: none; }
.panel {
  width: 100%; max-width: 760px; min-width: 0; margin: auto;
  background: var(--panel); border: 1px solid var(--line); border-radius: 10px;
  padding: 24px; box-sizing: border-box;
}
.title { font-family: var(--font-display); font-size: clamp(34px, 8vw, 58px); line-height: 1; margin: 0; letter-spacing: .02em; text-transform: uppercase; text-wrap: balance; }
.title span { color: var(--accent); }
.lead { margin: 10px 0 20px; color: var(--ink-dim); font-size: 17px; max-width: 52ch; }
.levels { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; }
.card {
  text-align: left; min-width: 0;
  background: rgba(247, 236, 220, 0.06); border: 1px solid var(--line); border-radius: 8px;
  padding: 14px; display: flex; flex-direction: column; gap: 6px;
}
.card:hover { border-color: var(--accent); background: rgba(247,236,220,.1); }
.card h3 { margin: 0; font-family: var(--font-display); font-weight: 400; font-size: 20px; text-transform: uppercase; letter-spacing: .02em; }
.card .meta { color: var(--ink-dim); font-size: 14px; }
.card .best { font-size: 14px; font-weight: 600; font-variant-numeric: tabular-nums; }
.stars { color: var(--accent); letter-spacing: 3px; font-size: 18px; }
.stars .off { color: rgba(247,236,220,.25); }
.diff { font-size: 12px; text-transform: uppercase; letter-spacing: .1em; font-weight: 600; }
.diff.d1 { color: #8fd694; } .diff.d2 { color: var(--accent); } .diff.d3 { color: #ff7a6b; }
.keys { margin-top: 20px; display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 8px 20px; color: var(--ink-dim); font-size: 14px; }
.keys b { color: var(--ink); font-weight: 600; }
kbd {
  display: inline-block; min-width: 20px; text-align: center; padding: 1px 6px; margin-right: 2px;
  border: 1px solid var(--line); border-bottom-width: 3px; border-radius: 4px; background: rgba(247,236,220,.08);
  font-family: var(--font-body); font-size: 12px; font-weight: 600; color: var(--ink);
}
.big { font-family: var(--font-display); font-size: clamp(30px, 7vw, 46px); margin: 0 0 4px; text-transform: uppercase; }
.result { display: flex; flex-wrap: wrap; gap: 8px 28px; margin: 14px 0 18px; font-variant-numeric: tabular-nums; }
.result div { min-width: 0; }
.result small { display: block; color: var(--ink-dim); font-size: 12px; text-transform: uppercase; letter-spacing: .1em; font-weight: 600; }
.result strong { font-family: var(--font-display); font-weight: 400; font-size: 26px; }
.actions { display: flex; flex-wrap: wrap; gap: 10px; }
.btn {
  background: rgba(247,236,220,.08); border: 1px solid var(--line); border-radius: 6px;
  padding: 10px 16px; font-weight: 600; letter-spacing: .03em;
}
.btn:hover { border-color: var(--accent); }
.btn.primary { background: var(--accent); border-color: var(--accent); color: #241b3a; }
@media (prefers-reduced-motion: reduce) { #toast { transition: none; } }
@media (max-width: 520px) {
  #timer { font-size: 24px; }
  .chip { padding: 5px 8px; font-size: 12px; }
  .panel { padding: 18px; }
}
</style>

<div id="app">
